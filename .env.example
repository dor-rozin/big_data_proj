# =============================================================================
# Configuration for the big data pipeline.
#
#   cp .env.example .env
#
# `.env` is gitignored; this file is the committed template and must stay a
# byte-for-byte mirror of it apart from any local overrides. Every variable is
# read either by docker-compose.yml itself or by a service via `env_file`.
#
# ---------------------------------------------------------------------------
# BEFORE YOUR FIRST RUN: get your own free API key and paste it in below.
#
#   Groq   (primary)  https://console.groq.com/keys        -> GROQ_API_KEY
#   Gemini (fallback) https://aistudio.google.com/apikey   -> GEMINI_API_KEY
#
# Get your OWN key rather than reusing a teammate's: the free budgets are
# metered per key, so a shared one is exhausted N times as fast. Keys live in
# `.env` only and are never committed.
#
# Everything else in this file already has a working value. Variables left
# deliberately blank (REPLAY_SPLIT_AT, REPLAY_SPEED, REPLAY_MODE,
# LLM_MIN_INTERVAL_SECONDS, PROMPT_PATH) mean "use the built-in default" —
# leave them empty unless you intend to override something.
# ---------------------------------------------------------------------------
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka connectivity
# -----------------------------------------------------------------------------
# One broker, two listeners (see the listener contract at the top of
# docker-compose.yml). Which one you want depends on where your process runs:
#
#   KAFKA_BOOTSTRAP      -> clients INSIDE the compose network (producer, spark)
#   KAFKA_BOOTSTRAP_HOST -> clients on the HOST (scripts run from .venv)
#
# Getting these backwards is the classic failure in this stack: the broker
# starts, the logs look clean, and the client times out with no useful error.
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_BOOTSTRAP_HOST=localhost:29092

# -----------------------------------------------------------------------------
# Topics
# -----------------------------------------------------------------------------
# Frozen by schemas/README.md. The `.v1` suffix is part of the contract: a
# breaking schema change means a NEW topic, not a new value here.
PRICES_TOPIC=market.prices.v1
FILINGS_TOPIC=sec.filings.v1
TEXT_TOPIC=sec.text.v1

# Provisioning, applied by scripts/create_topics.py (the `topic-init` service).
#
# 3 partitions: lets the consumer half demonstrate parallel consumption. This
#   cannot be lowered after creation, so it is set deliberately rather than
#   inherited from Kafka's default of 1.
# -1 retention: keep messages forever. Kafka's default is 7 days, which means
#   data written on Monday silently disappears the following Tuesday and the
#   failure looks like a consumer bug.
TOPIC_PARTITIONS=3
TOPIC_REPLICATION=1
TOPIC_RETENTION_MS=-1

# -----------------------------------------------------------------------------
# Producer (snapshot replay)
# -----------------------------------------------------------------------------
# Directory holding the snapshot parquet files, as seen from inside the
# producer container. docker-compose.yml mounts ./historical_data here.
SNAPSHOT_DIR=/snapshots

# --- the backfill / live split ----------------------------------------------
# The snapshot is divided at one instant: the first price bar + BACKFILL_DAYS.
# The `producer` service sends everything before it (instantly, so the topics
# start out looking like a system that has been running for a year); the
# `producer-live` service sends everything after it (slowly, as if arriving
# now). Both read this same value, which is what guarantees they don't overlap
# or leave a gap -- change it here, never in one service's command.
#
# With the current snapshot (prices 2024-08-05 -> 2026-08-03) 365 days puts the
# split at 2025-08-05: 3,435 events backfilled, 2,594 streamed live.
BACKFILL_DAYS=365

# Optional hard override of the boundary, as YYYY-MM-DD. Leave empty to derive
# it from BACKFILL_DAYS above.
REPLAY_SPLIT_AT=

# --- pacing ------------------------------------------------------------------
# instant   -- produce as fast as the broker accepts.
# realtime  -- compress the span into REPLAY_DURATION seconds of wall clock,
#              preserving the relative spacing between events.
# <number>  -- a float multiplier on the original event spacing, e.g. 100.
#
# Leave EMPTY to get the right default per mode: instant for the backfill,
# realtime for the live stream. Setting it here overrides both.
REPLAY_SPEED=

# Wall-clock seconds the live stream is spread over. Only used by `realtime`.
# 300 = the live year plays out over five minutes.
REPLAY_DURATION=300

# Cap on total messages produced. 0 = no cap. Useful for smoke tests.
REPLAY_LIMIT=0

# Restart the replay from the beginning when it finishes, so an unattended demo
# never runs dry. true/false. Note this re-sends the same messages; the team
# design is at-least-once with an idempotent document id downstream.
REPLAY_LOOP=false

# Mode is set per-service in docker-compose.yml (--mode backfill / --mode live),
# so this stays empty. Set it only if you run produce.py directly and want a
# default other than `all`.
REPLAY_MODE=

# -----------------------------------------------------------------------------
# Live producer -- real trades from Finnhub, aggregated into bars
# (producer/live_producer.py, optional, alongside the snapshot replay above)
# -----------------------------------------------------------------------------
# Free key: https://finnhub.io/register -> dashboard shows the token directly.
# Left blank on purpose -- get your OWN key, same reasoning as GROQ/GEMINI above.
# live_producer.py exits with a clear message if this is unset; nothing else in
# the pipeline needs it.
FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ES_HOST=http://elasticsearch:9200
ES_HOST_EXTERNAL=http://localhost:9200
PRICES_INDEX=stock_prices
FILINGS_INDEX=stock_filings
ANALYSIS_INDEX=stock_analysis

# The stage-3 aggregate: exactly what each analyst prompt was built from. Written
# before the API call and regardless of whether one happens, so the context
# survives a quota failure or an LLM_ENABLED=false run.
CONTEXT_INDEX=stock_context

# Documents per bulk request. The Spark job streams the DataFrame rather than
# collecting it, so this bounds request size, not memory.
ES_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# Spark — anomaly detection (MLlib KMeans)
# -----------------------------------------------------------------------------
# Features are z-scored within each (ticker, interval) group, then one KMeans is
# fitted across every group. Scaling per group means each instrument is judged
# against its own history; one global fit is what keeps it scaling as the ticker
# universe grows.
KMEANS_K=3

# Fraction of bars flagged as anomalous, applied per group so that volatile
# names do not crowd quieter ones out of the results.
ANOMALY_FRACTION=0.05

# Groups with fewer bars than this are passed through unflagged — a 3-cluster
# fit over a handful of points describes noise, not behaviour.
MIN_ROWS_PER_GROUP=30

# Shuffle partitions. The default of 200 is far too many for a dataset this
# size; raise this as the snapshot grows.
SHUFFLE_PARTITIONS=8

# -----------------------------------------------------------------------------
# Spark — analyst stage: which LLM provider
# -----------------------------------------------------------------------------
# gemini | groq. Only the transport differs — the prompt, the context, the JSON
# contract, the pacing and the retries are shared, so switching providers is one
# line here and nothing else.
#
#   gemini  free tier is tight: ~5 req/min AND ~30 calls/day. Good quality,
#           but budget about two full runs per day on one key.
#   groq    much faster (sub-second calls) and higher limits, but the free tier
#           is capped at 100,000 TOKENS PER DAY, not requests. A ten-instrument
#           run costs ~13k tokens, so budget about 7 runs a day.
LLM_PROVIDER=groq

# Ordered fallback chain, tried left to right when the one before it is retired.
# Leave empty for no fallback. See "How the chain moves" in README.md.
#
#   groq,gemini         two hosted providers, separate quotas
#   groq,gemini,ollama  plus a local model that cannot run out
#
# `ollama` requires the container to be running:
#   docker compose --profile local-llm up -d ollama
#   docker compose --profile local-llm exec ollama ollama pull llama3.2:3b
LLM_FALLBACK_PROVIDERS=gemini

# --- gemini ---
# Free key: https://aistudio.google.com/apikey   (put the value in .env only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- groq ---
# Free key: https://console.groq.com/keys
# List what your key can reach:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models | grep '"id"'
#
# llama-3.3-70b-versatile is the pick: 131k context, reliable JSON output, and
# strong enough for the nuance this task needs (a null fact means "not
# reported", never zero). Avoid groq/compound* — those are agentic and can
# fetch external data, which breaks the prompt's "use only the data provided"
# rule.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- ollama (local fallback, no key, no quota) ---
# Small on purpose: this runs on CPU inside Docker, so a 3B model is the largest
# that stays practical. Quality is well below the hosted models — it exists so a
# run finishes, not to match them. Every analysis records which model wrote it.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://ollama:11434

# Set false to run the whole pipeline with the analyst stage skipped. Useful for
# iterating on the Spark transformations without spending API quota.
LLM_ENABLED=true

# Parallel API calls. Gemini's free tier allows only a few requests per minute,
# so the default is serial — concurrency here causes rejections, not speed.
LLM_CONCURRENCY=1

# Minimum seconds between calls. Leave EMPTY to get the right default for the
# provider — 13s for gemini (whose free tier is ~5 req/min), 1s for groq. Set a
# value here only to override both.
#
# Pacing cannot rescue an exhausted DAILY budget — when that happens the
# provider asks for a wait measured in minutes, the client refuses anything over
# 60s (MAX_BACKOFF in spark/llm.py), and the affected instruments are recorded
# as failures so the run still finishes. Use LLM_ENABLED=false while iterating
# on the Spark stages and spend the budget on runs that matter.
LLM_MIN_INTERVAL_SECONDS=

# Hard ceiling on API calls per run. When it truncates, the tickers that were
# skipped are named in the log — a silent cap would read as full coverage.
LLM_MAX_CALLS=50

# Characters of filing text sent per instrument. Truncation is deterministic
# (a prefix), so the same input always produces the same prompt.
LLM_MAX_TEXT_CHARS=6000

# Safety guard: the aggregate is collected to the driver, and it is small by
# construction. This fails the stage loudly rather than risking a driver OOM if
# the aggregation grain ever changes.
LLM_MAX_COLLECT_ROWS=500

# Where the .txt analyst notes are written inside the container.
LLM_OUTPUT_DIR=/app/llm_output

# Path to the analyst prompt inside the container. Override only if you keep an
# alternative prompt alongside the default; edit spark/prompts/analyst.md to
# change the prompt itself.
PROMPT_PATH=

# Spark's Kafka connector, resolved at runtime via spark.jars.packages and cached
# in the spark-ivy volume. Must match the pyspark version in
# spark/requirements.txt.
KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1

# -----------------------------------------------------------------------------
# Dashboard (Streamlit)
# -----------------------------------------------------------------------------
# How many fiscal years the seven charts cover by default. The sidebar slider
# overrides it per session (3-8); this is only the value it starts on.
DASHBOARD_YEARS=5

# The dashboard's own AI analyst (stage 3) reuses the LLM settings above:
# LLM_PROVIDER picks the provider, the matching *_API_KEY and *_MODEL are used,
# and LLM_ENABLED=false switches it off along with the Spark stage. It does NOT
# use LLM_FALLBACK_PROVIDERS: it makes one call for one company when a button is
# clicked, so there is nothing to fail over in the middle of.
#
# Path to that prompt inside the container. Override only if you keep an
# alternative alongside the default; to change the prompt itself, edit
# dashboard/prompts/analyst_fundamentals.md.
DASHBOARD_PROMPT_PATH=
