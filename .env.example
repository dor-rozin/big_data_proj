# =============================================================================
# Configuration for the big data pipeline.
#
#   cp .env.example .env
#
# `.env` is gitignored; this file is the committed template and must stay a
# byte-for-byte mirror of it apart from any local overrides. Every variable is
# read either by docker-compose.yml itself or by a service via `env_file`.
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka connectivity
# -----------------------------------------------------------------------------
# One broker, two listeners (see the listener contract at the top of
# docker-compose.yml). Which one you want depends on where your process runs:
#
#   KAFKA_BOOTSTRAP      -> clients INSIDE the compose network (producer, spark)
#   KAFKA_BOOTSTRAP_HOST -> clients on the HOST (scripts run from .venv)
#
# Getting these backwards is the classic failure in this stack: the broker
# starts, the logs look clean, and the client times out with no useful error.
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_BOOTSTRAP_HOST=localhost:29092

# -----------------------------------------------------------------------------
# Topics
# -----------------------------------------------------------------------------
# Frozen by schemas/README.md. The `.v1` suffix is part of the contract: a
# breaking schema change means a NEW topic, not a new value here.
PRICES_TOPIC=market.prices.v1
FILINGS_TOPIC=sec.filings.v1
TEXT_TOPIC=sec.text.v1

# Provisioning, applied by scripts/create_topics.py (the `topic-init` service).
#
# 3 partitions: lets the consumer half demonstrate parallel consumption. This
#   cannot be lowered after creation, so it is set deliberately rather than
#   inherited from Kafka's default of 1.
# -1 retention: keep messages forever. Kafka's default is 7 days, which means
#   data written on Monday silently disappears the following Tuesday and the
#   failure looks like a consumer bug.
TOPIC_PARTITIONS=3
TOPIC_REPLICATION=1
TOPIC_RETENTION_MS=-1

# -----------------------------------------------------------------------------
# Producer (snapshot replay)
# -----------------------------------------------------------------------------
# Directory holding the snapshot parquet files, as seen from inside the
# producer container. docker-compose.yml mounts ./historical_data here.
SNAPSHOT_DIR=/snapshots

# --- the backfill / live split ----------------------------------------------
# The snapshot is divided at one instant: the first price bar + BACKFILL_DAYS.
# The `producer` service sends everything before it (instantly, so the topics
# start out looking like a system that has been running for a year); the
# `producer-live` service sends everything after it (slowly, as if arriving
# now). Both read this same value, which is what guarantees they don't overlap
# or leave a gap -- change it here, never in one service's command.
#
# With the current snapshot (prices 2024-08-05 -> 2026-08-03) 365 days puts the
# split at 2025-08-05: 3,375 events backfilled, 2,538 streamed live.
BACKFILL_DAYS=365

# Optional hard override of the boundary, as YYYY-MM-DD. Leave empty to derive
# it from BACKFILL_DAYS above.
REPLAY_SPLIT_AT=

# --- pacing ------------------------------------------------------------------
# instant   -- produce as fast as the broker accepts.
# realtime  -- compress the span into REPLAY_DURATION seconds of wall clock,
#              preserving the relative spacing between events.
# <number>  -- a float multiplier on the original event spacing, e.g. 100.
#
# Leave EMPTY to get the right default per mode: instant for the backfill,
# realtime for the live stream. Setting it here overrides both.
REPLAY_SPEED=

# Wall-clock seconds the live stream is spread over. Only used by `realtime`.
# 300 = the live year plays out over five minutes.
REPLAY_DURATION=300

# Cap on total messages produced. 0 = no cap. Useful for smoke tests.
REPLAY_LIMIT=0

# Restart the replay from the beginning when it finishes, so an unattended demo
# never runs dry. true/false. Note this re-sends the same messages; the team
# design is at-least-once with an idempotent document id downstream.
REPLAY_LOOP=false

# Mode is set per-service in docker-compose.yml (--mode backfill / --mode live),
# so this stays empty. Set it only if you run produce.py directly and want a
# default other than `all`.
REPLAY_MODE=

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ES_HOST=http://elasticsearch:9200
ES_HOST_EXTERNAL=http://localhost:9200
PRICES_INDEX=stock_prices
FILINGS_INDEX=stock_filings

# -----------------------------------------------------------------------------
# Spark
# -----------------------------------------------------------------------------
# Fraction of days flagged as anomalies (top X% by distance to cluster centre).
ANOMALY_FRACTION=0.05

# -----------------------------------------------------------------------------
# Legacy — pending migration, do not build anything new on these
# -----------------------------------------------------------------------------
# `spark/pipeline.py` still reads a `news` topic and writes a `stock_news`
# index. No producer writes that topic any more: yfinance headlines were never
# part of the frozen contract, and their replacement is `sec.text.v1` (ticket
# 0010). These two variables exist only so the Spark job keeps resolving its
# config until that migration lands.
NEWS_TOPIC=sec.text.v1
NEWS_INDEX=stock_news
