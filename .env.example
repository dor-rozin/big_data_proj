# Copy this file to .env and adjust as needed.
# Tickers to pull from yfinance (comma-separated, no spaces).
TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA

# How much price history to pull.
PRICE_PERIOD=2y
PRICE_INTERVAL=1d

# Kafka topics.
PRICES_TOPIC=prices
NEWS_TOPIC=news

# Internal service addresses (used by containers, do not change unless you rename services).
KAFKA_BOOTSTRAP=kafka:29092
ES_HOST=http://elasticsearch:9200

# Elasticsearch index names.
PRICES_INDEX=stock_prices
NEWS_INDEX=stock_news

# Anomaly detection: fraction of days flagged as anomalies (top X% by distance).
ANOMALY_FRACTION=0.05
